#version 430 core

layout(local_size_x = 256) in;

struct Particle {
    vec4 color;
    vec3 position;
    float life;
    vec3 velocity;
    float collisionSize;
    vec2 scale;
    int dead;
};

layout(std430, binding = 9) buffer ParticleBuffer {
    Particle particles[];
};

uniform mat4 viewProjectionMatrix;
uniform int particleCount;

uniform float deltaTime;
uniform float nearPlane;
uniform float farPlane;

layout(binding = 0) uniform sampler2D sceneDepth;
layout(binding = 1) uniform sampler2D sceneNormal;

float linearize(float depth) {
    return (nearPlane * farPlane) / (nearPlane + depth * (farPlane - nearPlane));
}

void main() {
    uint index = gl_GlobalInvocationID.x;

    if(index >= particleCount) {
        return;
    }

    Particle p = particles[index];

    p.life -= deltaTime;

    //when should be dead, but p.dead has not been set to true
    if(p.life <= 0.0f && p.dead != 1) {
        p.position = vec3(0);
        p.velocity = vec3(0);
        p.life = 0;
        p.dead = 1;

        particles[index] = p;

        return;
    }

    p.velocity.y -= 20.0f * deltaTime; //gravity

    vec3 nextPos = p.position + p.velocity * deltaTime;
    vec4 clipPos = viewProjectionMatrix * vec4(nextPos, 1.0);
    vec3 ndc = clipPos.xyz / clipPos.w;

    if(
        ndc.x >= -1.0 && ndc.x <= 1.0 &&
        ndc.y >= -1.0 && ndc.y <= 1.0 &&
        ndc.z >= 0.0 && ndc.z <= 1.0
    ) {
        vec2 uv = ndc.xy * 0.5 + 0.5;
        float sampledDepth = texture(sceneDepth, uv).r;

        float particleZ = linearize(ndc.z);
        float sceneZ = linearize(sampledDepth);

        if(particleZ >= sceneZ - p.collisionSize) {
            vec3 normal = normalize(texture(sceneNormal, uv).xyz);
            p.velocity = reflect(p.velocity, normal) * 0.8;

            nextPos = p.position;
        }
    }

    p.position = nextPos;
    particles[index] = p;
}
