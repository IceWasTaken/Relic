  <library_effects>
    <effect id="Effect_aa_mizoBlue_v">
      <profile_COMMON>
        <newparam sid="surface_aa_mizoBlue_v-diffuse">
          <surface type="2D">
            <init_from>E_lv3r03_mizo</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_aa_mizoBlue_v-diffuse">
          <sampler2D>
            <source>surface_aa_mizoBlue_v-diffuse</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <diffuse>
              <texture texture="sampler_aa_mizoBlue_v-diffuse" texcoord="CHANNEL0" />
            </diffuse>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
