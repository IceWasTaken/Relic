          </surface>
        </newparam>
        <newparam sid="Image-sampler">
          <sampler2D>
            <source>Image-surface</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
            <minfilter>NONE</minfilter>
            <magfilter>NONE</magfilter>
            <mipfilter>NONE</mipfilter>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <emission>
              <color>0 0 0 1</color>
            </emission>
            <ambient>
              <color>0 0 0 1</color>
            </ambient>
            <diffuse>
              <texture texture="Image-sampler" texcoord=""/>
            </diffuse>
            <specular>
              <color>1 1 1 1</color>
            </specular>
            <shininess>
              <float>0</float>
            </shininess>
            <transparent opaque="A_ONE">
